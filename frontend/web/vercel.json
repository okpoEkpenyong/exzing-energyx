{
    "version": 2,
    "rewrites": [
      {
        "source": "/api/(.*)",
        "destination": "https://exzing-energyx.onrender.com/$1"
      }
    ],
    "headers": [
      {
        "source": "/(.*)",
        "headers": [
          { "key": "Access-Control-Allow-Origin", "value": "https://exzing-energyx.vercel.app" },
          { "key": "Access-Control-Allow-Origin", "value": "https://energyx.exzing.com" },
          { "key": "Access-Control-Allow-Methods", "value": "GET,POST,PUT,DELETE,OPTIONS" },
          { "key": "Access-Control-Allow-Headers", "value": "Content-Type, Authorization" }
        ]
      }
    ]
  }
  